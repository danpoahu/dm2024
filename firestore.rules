rules_version = '2';

// Discover More — Firestore security rules.
//
// HISTORY, so this is not "fixed" the wrong way again:
//   Until 2026-04-01 the rules were `match /{document=**}` with
//   `allow read, write: if request.auth != null` — everything, but only for a
//   signed-in user. That blocked the website, whose welcome flow creates a
//   person's record from just a name and email with no password.
//   On 2026-04-01 that was replaced with a single `match /results/{docId}`
//   rule. It fixed the website, but Firestore denies anything not explicitly
//   matched, so Team, users, dmdate, emailLog and medications all became
//   unreadable — and the iOS/Android Admin screen, which queries
//   `Team where Active == "yes"`, started failing with
//   "Missing or insufficient permissions".
//
// So neither old version is right. This keeps the website working AND gives
// the apps their collections back.

service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC — no sign-in required.
    // discovermore.app/app/ identifies people by name + email in session only;
    // there is no password on that path, so this collection must stay reachable
    // to an unauthenticated client. This is the part the 2026-04-01 change got
    // right and it is still required.
    match /results/{docId} {
      allow read, write: if true;
    }

    // SIGNED-IN ONLY — everything below is touched exclusively by the iOS and
    // Android apps, which do authenticate (Auth.auth().signIn in
    // LoginSignupView.swift). The website never reads these, so requiring a
    // signed-in user cannot break it.
    //
    // Team in particular holds names, emails and phone numbers of church
    // volunteers. Leaving it open to the world the way `results` is would
    // publish that roster to anyone who knows the project id.
    match /Team/{docId} {
      allow read, write: if request.auth != null;
    }
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }
    match /dmdate/{docId} {
      allow read, write: if request.auth != null;
    }
    match /emailLog/{docId} {
      allow read, write: if request.auth != null;
    }
    match /medications/{docId} {
      allow read, write: if request.auth != null;
    }

    // PUBLIC — Gene Pellegrini memorial page (oahuappdesign.com/Gene/, 2026-10-01).
    // Anyone may read and add a memory or prayer; nobody can edit or delete one
    // from the page. The family hides a message by setting hidden: true in the
    // console (the page leaves those out); clients can never set it.
    match /memorialGeneMessages/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'kind', 'relation', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.kind in ['memory', 'prayer']
        && (!('relation' in request.resource.data)
            || (request.resource.data.relation is string && request.resource.data.relation.size() <= 80))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Visit counter for the same page: one doc, views +1 per load, visitors +1
    // the first time a browser comes. Nothing else can be written.
    match /memorialGeneStats/{docId} {
      allow read: if true;
      allow create: if docId == 'visits'
        && request.resource.data.keys().hasOnly(['views', 'visitors', 'updatedAt'])
        && request.resource.data.views == 1 && request.resource.data.visitors == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if docId == 'visits'
        && request.resource.data.keys().hasOnly(['views', 'visitors', 'updatedAt'])
        && request.resource.data.views == resource.data.views + 1
        && (request.resource.data.visitors == resource.data.visitors
            || request.resource.data.visitors == resource.data.visitors + 1)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
